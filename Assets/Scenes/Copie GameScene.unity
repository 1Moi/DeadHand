  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\xC7a fait quelques semaines qu\u2019Alexandra est partie, Vera se montre
    de plus en plus hostile et j\u2019aper\xE7ois \xE0 peine Sergei.\n\nIl a beaucoup
    \xE0 faire, nous aussi d\u2019ailleurs, on doit reprendre le travail de celle
    qui nous a abandonn\xE9. Je fais de mon mieux pour retarder au maximum l\u2019in\xE9vitable
    de ce projet.\n\nC\u2019est compliqu\xE9 puisque maintenant je suis seule et
    je sens les yeux de Vera constamment sur moi.\n\nAujourd\u2019hui je dois m\u2019occuper
    du calibrage de la machine, je vais faire en sorte de d\xE9tourner comme je peux
    les cibles vis\xE9es.\n\nHonn\xEAtement je ne sais pas si tout ce travail va
    servir \xE0 quelque chose mais je refuse de laisser \xE7a tel quel. nous avons
    particip\xE9 \xE0 un projet dangereux pour tous je me dois de rattraper mes erreurs."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
